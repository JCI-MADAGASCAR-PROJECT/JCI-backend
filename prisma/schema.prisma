generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  password            String
  role                Role               @default(NONE)
  organisationLocalId Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastLogin           DateTime?
  organisationLocal   OrganisationLocal? @relation(fields: [organisationLocalId], references: [id])
}

model BureauNational {
  id        Int      @id @default(autoincrement())
  name      String
  firstName String
  title     String   @unique
  imgUrl    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PastPresident {
  id        Int      @id @default(autoincrement())
  name      String
  year      Int      @unique
  imgUrl    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  imgUrl             String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organisationLocals OrganisationLocal[]
  zonePresident      ZonePresident?
}

model ZonePresident {
  id        Int      @id @default(autoincrement())
  name      String
  quote     String
  imgUrl    String
  contact   String
  zoneId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model OrganisationLocal {
  id                        Int                        @id @default(autoincrement())
  name                      String
  localisation              String
  phone                     String
  email                     String
  mapImgUrl                 String
  logoImgUrl                String
  zoneId                    Int
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  events                    Event[]
  members                   Member[]
  zone                      Zone                       @relation(fields: [zoneId], references: [id])
  organisationLocalContents OrganisationLocalContent[]
  users                     User[]

  @@unique([name, zoneId])
}

model OrganisationLocalContent {
  id                  Int               @id @default(autoincrement())
  content             String
  organisationLocalId Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organisationLocal   OrganisationLocal @relation(fields: [organisationLocalId], references: [id], onDelete: Cascade)
}

/// ===============================THESE ARE THE MEMBER MODELS.======================================= 
model Member {
  id                  Int               @id @default(autoincrement())
  name                String
  imgUrl              String
  title               String
  ticket              String
  organisationLocalId Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organisationLocal   OrganisationLocal @relation(fields: [organisationLocalId], references: [id], onDelete: Cascade)
}

model Event {
  id                  Int                @id @default(autoincrement())
  title               String
  type                String
  imgUrl              String
  content             String
  date                DateTime
  organisationLocalId Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organisationLocal   OrganisationLocal? @relation(fields: [organisationLocalId], references: [id])
  files               EventFile[]
  images              EventImage[]
}

model EventImage {
  id        Int      @id @default(autoincrement())
  imgUrl    String
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventFile {
  id        Int      @id @default(autoincrement())
  fileUrl   String
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  price       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imgUrl      String
}

enum Role {
  SUPER_ADMIN
  ADMIN_NATIONAL
  ADMIN_LOCAL
  ADMIN_E_COMMERCE
  NONE
}
